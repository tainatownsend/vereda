{
  "name": "vereda",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "content:manifest:validate": "node scripts/content_pipeline/validate_manifest.mjs",
    "content:sources:report": "node scripts/content_pipeline/create_source_report.mjs",
    "content:sources:inspect": "node scripts/content_pipeline/run_python.mjs scripts/content_pipeline/inspect_sources.py",
    "content:structure:extract": "node scripts/content_pipeline/run_python.mjs scripts/content_pipeline/extract_structure_maps.py",
    "content:structure:validate": "node scripts/content_pipeline/validate_structure_maps.mjs",
    "content:structure:test": "node scripts/content_pipeline/run_python.mjs -m unittest tests/content_pipeline/test_structure_parser.py",
    "content:comparison:import": "node scripts/content_pipeline/import_current_structure.mjs",
    "content:comparison:run": "node scripts/content_pipeline/run_python.mjs scripts/content_pipeline/compare_structures.py",
    "content:comparison:validate": "node scripts/content_pipeline/validate_comparison.mjs",
    "content:comparison:test": "node scripts/content_pipeline/run_python.mjs -m unittest tests/content_pipeline/test_structure_comparison.py",
    "content:reconstruction:build": "node scripts/content_pipeline/run_python.mjs scripts/content_pipeline/build_reconstruction_plan.py",
    "content:reconstruction:validate": "node scripts/content_pipeline/validate_reconstruction_plan.mjs",
    "content:reconstruction:test": "node scripts/content_pipeline/run_python.mjs -m unittest tests/content_pipeline/test_reconstruction_plan.py",
    "content:staging:build": "node scripts/content_pipeline/run_python.mjs scripts/content_pipeline/build_staging_manifest.py",
    "content:staging:validate": "node scripts/content_pipeline/validate_staging_foundation.mjs",
    "content:staging:test": "node scripts/content_pipeline/run_python.mjs -m unittest tests/content_pipeline/test_staging_manifest.py",
    "content:staging:preflight:import": "node scripts/content_pipeline/import_staging_preflight.mjs",
    "content:staging:preflight:validate": "node scripts/content_pipeline/validate_staging_preflight.mjs",
    "content:staging:post-apply:import": "node scripts/content_pipeline/import_staging_post_apply.mjs",
    "content:staging:post-apply:validate": "node scripts/content_pipeline/validate_staging_post_apply.mjs",
    "content:staging:nodes:build": "node scripts/content_pipeline/run_python.mjs scripts/content_pipeline/build_editorial_node_load.py",
    "content:staging:nodes:validate": "node scripts/content_pipeline/validate_editorial_node_load.mjs",
    "content:staging:nodes:test": "node scripts/content_pipeline/run_python.mjs -m unittest tests/content_pipeline/test_editorial_node_load.py",
    "content:staging:nodes:verify:import": "node scripts/content_pipeline/import_editorial_node_verification.mjs",
    "content:staging:nodes:verify:validate": "node scripts/content_pipeline/validate_editorial_node_evidence.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
