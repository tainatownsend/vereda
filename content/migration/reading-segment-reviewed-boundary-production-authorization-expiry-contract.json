{
  "package_id": "reading-segment-reviewed-boundary-production-readiness-closure",
  "package_version": "1.0.0",
  "target_count": 74,
  "canonical_hashing": {
    "version": "reviewed-boundary-production-readiness-hash-v1",
    "rules": [
      "JSON-finalized semantic values",
      "recursive lexicographic object-key ordering",
      "preserved array order",
      "whitespace-free JSON",
      "UTF-8",
      "lowercase SHA-256",
      "only self-hash excluded",
      "closed-world fields",
      "null significant",
      "undefined forbidden",
      "validators hash persisted semantic representation"
    ]
  },
  "validity_hours": 4,
  "distinct_from_staging_observation_hours": 24,
  "invalidators": [
    "evidence age",
    "source or manifest hash change",
    "identity or schema change",
    "target, operation, row or status change",
    "content or boundary drift",
    "audit change",
    "staging validation revocation",
    "staging rollback",
    "superseded collection",
    "explicit revocation",
    "production execution starts or completes",
    "rollback starts or completes"
  ]
}
