{
  "schema_version": "pr0058-runtime-reconstruction-v1",
  "hash_algorithm": "sha256-canonical-json-v1",
  "normalization_algorithm": "reviewed-boundary-content-normalization-v1",
  "normalization_implementation": "scripts/content_pipeline/reviewed_boundary_content_normalization.mjs",
  "identity_fields": [
    "run_id",
    "book_id",
    "segment_key"
  ],
  "boundary_fields": [
    "source_key",
    "segment_order",
    "segment_index",
    "segment_count",
    "boundary_version",
    "start_locator",
    "end_locator",
    "display_title"
  ],
  "content_fields": [
    "recomputed_normalized_content_sha256",
    "recomputed_word_count",
    "normalized_content_length",
    "content_byte_length"
  ],
  "status_fields": [
    "observed_approval_status",
    "expected_previous_approval_status",
    "intended_resulting_approval_status"
  ],
  "timestamps_excluded_from_hashes": [
    "created_at",
    "updated_at"
  ],
  "stored_digest_never_sufficient": true
}
