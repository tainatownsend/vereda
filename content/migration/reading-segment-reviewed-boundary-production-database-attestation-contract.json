{
  "package_id": "reading-segment-reviewed-boundary-production-readiness-closure",
  "package_version": "1.0.0",
  "target_count": 74,
  "canonical_hashing": {
    "version": "reviewed-boundary-production-readiness-hash-v1",
    "rules": [
      "JSON-finalized semantic values",
      "recursive lexicographic object-key ordering",
      "preserved array order",
      "whitespace-free JSON",
      "UTF-8",
      "lowercase SHA-256",
      "only self-hash excluded",
      "closed-world fields",
      "null significant",
      "undefined forbidden",
      "validators hash persisted semantic representation"
    ]
  },
  "environment_class": "production",
  "fields": [
    "environment_class",
    "redacted_database_project_fingerprint",
    "postgresql_major_version",
    "database_schema_fingerprint",
    "migration_fingerprint",
    "required_table_column_inventory",
    "audit_extension_fingerprint",
    "collection_mode",
    "target_count",
    "evidence_sha256",
    "runtime_manifest_sha256",
    "collection_identifier",
    "operator_identity_reference",
    "collection_timestamp",
    "identity_attestation_version",
    "attestation_sha256"
  ],
  "forbidden_fields": [
    "raw_database_host",
    "raw_project_reference",
    "username",
    "password",
    "connection_string",
    "api_key",
    "access_token"
  ],
  "must_differ_from_staging": true
}
